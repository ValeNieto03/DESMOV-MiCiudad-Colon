{
    "expo":  {
                 "name":  "MiCiudad",
                 "slug":  "mi-ciudad-colon",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/icon.png",
                 "scheme":  "miciudad",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "supportsTablet":  true
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#F7F3E8",
                                                      "foregroundImage":  "./assets/images/icon.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.desmovgrupo16.miciudadcolon",
                                 "googleServicesFile":  "./google-services.json"
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/images/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#208AEF",
                                         "image":  "./assets/images/splash-icon.png",
                                         "imageWidth":  76
                                     }
                                 ],
                                 [
                                     "expo-audio",
                                     {
                                         "enableBackgroundPlayback":  true
                                     }
                                 ],
                                 "expo-sqlite",
                                 "expo-secure-store",
                                 "expo-asset",
                                 "expo-image",
                                 "expo-status-bar",
                                 "expo-web-browser",
                                 "expo-notifications",
                                 "./plugins/withCleartextTraffic",
                                 [
                                     "expo-build-properties",
                                     {
                                         "android":  {
                                                         "extraProguardRules":  "-keep class * extends androidx.room.RoomDatabase { \u003cinit\u003e(); }\n-keep class * extends androidx.work.InputMerger { \u003cinit\u003e(); }\n-keep enum expo.modules.sqlite.SQLAction { *; }"
                                                     }
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "c09c5370-cf81-4899-a9c3-b4beb41758d1"
                                       }
                           },
                 "owner":  "desmov-grupo-16"
             }
}
